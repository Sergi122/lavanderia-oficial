rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function usuarioActual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esSuperadmin() {
      return usuarioActual().role == 'superadmin';
    }

    // Campos que solo escribe el backend de verificación automática (cuenta
    // de servicio, salta las reglas). El postulante no puede fabricarlos.
    function tocaCamposDelBackend() {
      let campos = ['verificacionAutomaticaDistancia', 'verificacionAutomaticaCoincide',
        'posibleDuplicado', 'motivoDuplicado', 'discrepanciaDocumentos', 'motivoDiscrepancia',
        'pruebaVidaOk', 'motivoPruebaVida'];
      return request.resource.data.keys().hasAny(campos) &&
        (resource == null || request.resource.data.diff(resource.data).affectedKeys().hasAny(campos));
    }

    match /usuarios/{uid} {
      // Antes cualquier usuario logueado podía leer el perfil de CUALQUIER
      // otro (nombre, correo, rol...) sin importar quién fuera. Ahora solo:
      // el dueño de la cuenta, el superadmin, o el perfil público mínimo de
      // un empleado que se puso "disponible" (bolsa de empleo, ver
      // empleadosDisponiblesProvider — ahí sí es intencional que cualquiera
      // vea nombre/teléfono/bio, es la gracia de la bolsa).
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        esSuperadmin() ||
        (resource.data.role == 'empleado' && resource.data.lavanderiaId == null) ||
        (usuarioActual().role == 'admin' && resource.data.lavanderiaId == usuarioActual().lavanderiaId)
      );
      // el registro siempre entra como cliente; nadie se autoasigna admin/verificador/repartidor/superadmin
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.role == 'cliente' &&
        request.resource.data.get('activo', true) == true &&
        request.resource.data.get('lavanderiaId', null) == null &&
        request.resource.data.get('salarioEmpleado', null) == null;
      // el dueño de la cuenta puede editar su perfil (mientras no esté suspendida),
      // pero no puede tocar su propio rol (ni siquiera a "empleado" — eso requiere
      // que el admin de una lavandería en particular lo apruebe, ver más abajo),
      // ni reactivarse a sí mismo si un superadmin lo suspendió
      allow update: if request.auth != null && request.auth.uid == uid &&
        resource.data.activo != false &&
        request.resource.data.activo == resource.data.activo &&
        request.resource.data.role == resource.data.role &&
        // sin esto un cliente se ponía el lavanderiaId de cualquier negocio y
        // leía todos sus pedidos (direcciones, nombres, fotos de entrega)
        request.resource.data.get('lavanderiaId', null) == resource.data.get('lavanderiaId', null) &&
        request.resource.data.get('salarioEmpleado', null) == resource.data.get('salarioEmpleado', null);
      // "Eliminar mi cuenta": solo roles sin negocio a cargo (un dueño o el
      // equipo lo piden por soporte para no dejar pedidos huérfanos).
      allow delete: if request.auth != null && request.auth.uid == uid &&
        resource.data.role in ['cliente', 'empleado', 'repartidor'];
      // el verificador promueve a un cliente a repartidor al aprobar su solicitud
      // (single etapa) — nunca sobre su propia cuenta. La promoción a dueño de
      // lavandería (admin) la hace el superadmin en la segunda etapa de revisión
      // del local, no el verificador (que solo confirma identidad).
      allow update: if request.auth != null && usuarioActual().role == 'verificador' &&
        uid != request.auth.uid &&
        request.resource.data.role == 'repartidor' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
      // el admin de una lavandería aprueba a SUS propios postulantes a empleado
      // (nunca sobre su propia cuenta, y el nuevo lavanderiaId debe ser el suyo,
      // no el de un negocio ajeno) — reemplaza la vieja autopromoción instantánea.
      // El get() cruzado es necesario: sin él, un admin podría "robarse" a
      // cualquier cliente hacia su propio negocio aunque nunca haya postulado
      // ahí (o haya postulado a otra lavandería distinta).
      allow update: if request.auth != null && usuarioActual().role == 'admin' &&
        uid != request.auth.uid &&
        resource.data.role == 'cliente' &&
        request.resource.data.role == 'empleado' &&
        request.resource.data.lavanderiaId == usuarioActual().lavanderiaId &&
        get(/databases/$(database)/documents/solicitudes_empleado/$(uid)).data.lavanderiaId
          == usuarioActual().lavanderiaId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'lavanderiaId']);
      // el superadmin (CEO) gestiona roles y puede suspender/reactivar cualquier cuenta
      allow update: if request.auth != null && esSuperadmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'lavanderiaId', 'activo']);
      // el admin puede "despedir" a un empleado de SU propia lavandería —
      // sigue siendo empleado, pero queda sin lavanderiaId (disponible para
      // que cualquier otro admin lo vea en la bolsa y lo contrate).
      allow update: if request.auth != null && usuarioActual().role == 'admin' &&
        resource.data.role == 'empleado' &&
        resource.data.lavanderiaId == usuarioActual().lavanderiaId &&
        request.resource.data.role == 'empleado' &&
        request.resource.data.lavanderiaId == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lavanderiaId']);
      // el admin contrata directo a un empleado que está en la bolsa de
      // disponibles (ya fue verificado una vez, no repite carnet/selfies).
      allow update: if request.auth != null && usuarioActual().role == 'admin' &&
        resource.data.role == 'empleado' && resource.data.lavanderiaId == null &&
        request.resource.data.role == 'empleado' &&
        request.resource.data.lavanderiaId == usuarioActual().lavanderiaId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lavanderiaId']);
      // el admin fija el salario de un empleado de SU propio equipo, para
      // que Finanzas sume la planilla automáticamente.
      allow update: if request.auth != null && usuarioActual().role == 'admin' &&
        resource.data.role == 'empleado' &&
        resource.data.lavanderiaId == usuarioActual().lavanderiaId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salarioEmpleado']);
    }

    // Datos públicos de lavanderías ya verificadas. El carnet y demás datos
    // sensibles de la solicitud nunca llegan aquí, solo a `solicitudes_lavanderia`.
    match /lavanderias/{lavanderiaId} {
      // pública sin login: la landing muestra lavanderías reales antes de iniciar sesión
      allow read: if true;
      // solo el superadmin publica un local (segunda etapa, tras confirmar
      // identidad); el verificador ya no crea/gestiona lavanderías directamente.
      allow create: if request.auth != null && esSuperadmin();
      allow update: if request.auth != null && (
        esSuperadmin() ||
        (usuarioActual().role == 'admin' &&
          resource.data.propietarioUid == request.auth.uid &&
          request.resource.data.propietarioUid == resource.data.propietarioUid &&
          request.resource.data.activo == resource.data.activo)
      );
      allow delete: if request.auth != null && esSuperadmin();

      // Gastos manuales del dueño para su panel de ingresos/egresos.
      match /egresos/{egresoId} {
        allow read: if request.auth != null && (
          (usuarioActual().role == 'admin' && usuarioActual().lavanderiaId == lavanderiaId) ||
          esSuperadmin()
        );
        allow create: if request.auth != null &&
          ((usuarioActual().role == 'admin' && usuarioActual().lavanderiaId == lavanderiaId) ||
            esSuperadmin()) &&
          request.resource.data.creadoPor == request.auth.uid;
        allow update, delete: if false;
      }

      // Copia pública y mínima de cada calificación (sin datos del pedido),
      // para poder mostrar un promedio a cualquier cliente.
      match /calificaciones/{pedidoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          request.resource.data.autorUid == request.auth.uid &&
          get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.clienteId == request.auth.uid &&
          get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.lavanderiaId == lavanderiaId &&
          get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.estado == 'entregado' &&
          request.resource.data.estrellas is int &&
          request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5;
        allow update, delete: if false;
      }
    }

    match /solicitudes_lavanderia/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || usuarioActual().role == 'verificador' || esSuperadmin());
      allow create: if request.auth != null && request.auth.uid == uid &&
        usuarioActual().activo != false &&
        request.resource.data.propietarioUid == uid &&
        request.resource.data.estado == 'pendiente' &&
        !tocaCamposDelBackend();
      // el dueño solo puede editar mientras está en 'pendiente' — una vez que
      // el verificador confirma su identidad, ya no puede tocar ni siquiera
      // el carnet/selfies (evita que cambie esos datos después de confirmada
      // la identidad pero antes de que el superadmin apruebe el local).
      allow update: if request.auth != null &&
        request.auth.uid == uid && resource.data.estado == 'pendiente' &&
        request.resource.data.estado == 'pendiente' &&
        request.resource.data.propietarioUid == uid &&
        !tocaCamposDelBackend();
      // primera etapa: el verificador solo confirma identidad (pendiente ->
      // identidadConfirmada) o rechaza; no puede aprobar el local directamente.
      allow update: if request.auth != null &&
        usuarioActual().role == 'verificador' &&
        resource.data.estado == 'pendiente' &&
        request.resource.data.estado in ['identidadConfirmada', 'rechazada'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'motivoRechazo']);
      // segunda etapa: el superadmin tiene control total (aprueba/rechaza el local,
      // y también puede intervenir en cualquier otro caso como CEO).
      allow update: if request.auth != null && esSuperadmin();
      allow delete: if request.auth != null && (esSuperadmin() || request.auth.uid == uid);
    }

    // Postulación para repartir (carnet + matrícula de moto). El verificador
    // la aprueba antes de que el usuario pueda tomar encargos de reparto.
    match /solicitudes_repartidor/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || usuarioActual().role == 'verificador' || esSuperadmin());
      allow create: if request.auth != null && request.auth.uid == uid &&
        usuarioActual().activo != false &&
        request.resource.data.uid == uid &&
        request.resource.data.estado == 'pendiente' &&
        !tocaCamposDelBackend();
      allow update: if request.auth != null && (
        (request.auth.uid == uid && resource.data.estado != 'aprobada' &&
          request.resource.data.estado == 'pendiente' &&
          request.resource.data.uid == uid &&
          !tocaCamposDelBackend()) ||
        usuarioActual().role == 'verificador' ||
        esSuperadmin()
      );
      allow delete: if request.auth != null &&
        (usuarioActual().role == 'verificador' || request.auth.uid == uid);
    }

    // Postulación para empleado (CV, carnet, selfies). La aprueba el admin
    // de esa lavandería en particular — no un verificador ni el superadmin —
    // porque es él quien decide a quién contrata para su propio negocio.
    match /solicitudes_empleado/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        (usuarioActual().role == 'admin' && usuarioActual().lavanderiaId == resource.data.lavanderiaId) ||
        esSuperadmin()
      );
      allow create: if request.auth != null && request.auth.uid == uid &&
        usuarioActual().activo != false &&
        request.resource.data.uid == uid &&
        request.resource.data.estado == 'pendiente' &&
        !tocaCamposDelBackend();
      allow update: if request.auth != null &&
        request.auth.uid == uid && resource.data.estado == 'pendiente' &&
        request.resource.data.estado == 'pendiente' &&
        request.resource.data.uid == uid &&
        !tocaCamposDelBackend();
      allow update: if request.auth != null &&
        usuarioActual().role == 'admin' &&
        usuarioActual().lavanderiaId == resource.data.lavanderiaId &&
        resource.data.estado == 'pendiente' &&
        request.resource.data.estado in ['aprobada', 'rechazada'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'motivoRechazo']);
      allow update: if request.auth != null && esSuperadmin();
      allow delete: if request.auth != null && (
        request.auth.uid == uid ||
        (usuarioActual().role == 'admin' && usuarioActual().lavanderiaId == resource.data.lavanderiaId) ||
        esSuperadmin()
      );
    }

    // Convocatorias de empleo que publica un admin. Cualquier usuario logueado
    // las puede ver (para que un empleado sin trabajo las explore); solo el
    // admin dueño de la lavandería las crea/gestiona.
    match /convocatorias/{convocatoriaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && usuarioActual().role == 'admin' &&
        request.resource.data.lavanderiaId == usuarioActual().lavanderiaId &&
        request.resource.data.abierta == true;
      allow update: if request.auth != null && usuarioActual().role == 'admin' &&
        resource.data.lavanderiaId == usuarioActual().lavanderiaId;
      allow delete: if false;

      // Postulaciones ligeras de empleados ya verificados (sin repetir
      // carnet/selfies) a una convocatoria puntual.
      match /postulantes/{uid} {
        allow read: if request.auth != null && (
          request.auth.uid == uid ||
          (usuarioActual().role == 'admin' &&
            get(/databases/$(database)/documents/convocatorias/$(convocatoriaId)).data.lavanderiaId
              == usuarioActual().lavanderiaId) ||
          esSuperadmin()
        );
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    // Tickets de soporte que un admin manda al CEO (botón "Contáctanos" del
    // dashboard). Solo el autor y el superadmin los ven; nadie los borra.
    match /tickets_soporte/{ticketId} {
      allow read: if request.auth != null &&
        (resource.data.autorUid == request.auth.uid || esSuperadmin());
      allow create: if request.auth != null &&
        request.resource.data.autorUid == request.auth.uid &&
        request.resource.data.estado == 'abierto';
      allow update: if request.auth != null && esSuperadmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'respuesta']);
      allow delete: if false;
    }

    // Pedido que un cliente está armando (casa en construcción en la ciudad
    // 3D del admin). Un doc por cliente; solo él lo escribe.
    match /intenciones_pedido/{uid} {
      allow read: if request.auth != null && (
        uid == request.auth.uid ||
        (usuarioActual().get('lavanderiaId', null) != null &&
          usuarioActual().lavanderiaId == resource.data.lavanderiaId) ||
        esSuperadmin()
      );
      allow create, update: if request.auth != null && uid == request.auth.uid &&
        request.resource.data.clienteUid == request.auth.uid &&
        request.resource.data.estado in ['armando', 'confirmada', 'cancelada'];
      allow delete: if request.auth != null && uid == request.auth.uid;
    }

    match /pedidos/{pedidoId} {
      // El repartidor asignado solo puede: (a) actualizar su ubicación en vivo,
      // o (b) avanzar UN paso de la cadena aceptado -> recogido -> enLavanderia
      // -> devolviendo -> completada. Devolver la ropa exige que la lavandería
      // ya la marcó 'listo', y cerrar la entrega exige foto de comprobante.
      function etapaActual() {
        return resource.data.get('etapaReparto', 'aceptado');
      }
      function repartidorAvanzaBien() {
        let cambios = request.resource.data.diff(resource.data).affectedKeys();
        let nueva = request.resource.data.get('etapaReparto', etapaActual());
        return
          (cambios.hasOnly(['repartidorLat', 'repartidorLng', 'repartidorActualizadoEn'])) ||
          (nueva == 'recogido' && etapaActual() == 'aceptado' &&
            cambios.hasOnly(['etapaReparto'])) ||
          (nueva == 'enLavanderia' && etapaActual() == 'recogido' &&
            cambios.hasOnly(['etapaReparto'])) ||
          (nueva == 'devolviendo' && etapaActual() == 'enLavanderia' &&
            resource.data.estado == 'listo' && cambios.hasOnly(['etapaReparto'])) ||
          (nueva == 'completada' && etapaActual() == 'devolviendo' &&
            request.resource.data.entregaCompletada == true &&
            request.resource.data.estado == 'entregado' &&
            request.resource.data.tieneComprobante == true &&
            exists(/databases/$(database)/documents/pedidos/$(pedidoId)/comprobante/foto) &&
            cambios.hasOnly(['etapaReparto', 'entregaCompletada', 'estado', 'tieneComprobante']));
      }

      allow read: if request.auth != null && (
        resource.data.clienteId == request.auth.uid ||
        (usuarioActual().get('lavanderiaId', null) != null &&
          usuarioActual().lavanderiaId == resource.data.lavanderiaId) ||
        (usuarioActual().role == 'repartidor' &&
          ((resource.data.repartidorUid == null &&
            resource.data.tipoEntrega == 'recojoDomicilio') ||
            resource.data.repartidorUid == request.auth.uid)) ||
        esSuperadmin()
      );
      allow create: if request.auth != null && request.resource.data.clienteId == request.auth.uid &&
        usuarioActual().activo != false &&
        request.resource.data.repartidorUid == null &&
        request.resource.data.entregaCompletada == false &&
        request.resource.data.calificacionLavanderia == null &&
        // nace recibido y con montos válidos, en una lavandería que existe
        request.resource.data.estado == 'recibido' &&
        request.resource.data.costoPrendas is number && request.resource.data.costoPrendas >= 0 &&
        request.resource.data.costoEnvio is number && request.resource.data.costoEnvio >= 0 &&
        exists(/databases/$(database)/documents/lavanderias/$(request.resource.data.lavanderiaId)) &&
        request.resource.data.get('precioConfirmado', false) == false &&
        // el recojo no puede costar menos que la tarifa base de la lavandería
        (request.resource.data.get('tipoEntrega', '') != 'recojoDomicilio' ||
          request.resource.data.costoEnvio >=
            get(/databases/$(database)/documents/lavanderias/$(request.resource.data.lavanderiaId)).data.get('costoEnvio', 0));
      allow update: if request.auth != null && (
        ( (usuarioActual().role == 'empleado' || usuarioActual().role == 'admin') &&
          usuarioActual().lavanderiaId == resource.data.lavanderiaId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['estado', 'ropaRecibidaEn', 'ropaRecibidaPor', 'costoPrendas', 'precioConfirmado',
             'prendas', 'prendasPorIA', 'cantidadRopaRegular']) &&
          request.resource.data.get('ropaRecibidaPor', request.auth.uid) in [request.auth.uid, resource.data.get('ropaRecibidaPor', null)] &&
          // el precio lo fija la lavandería con su lista, una sola vez
          // el registro de prendas (IA) y el precio se fijan juntos, una sola vez
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(
              ['costoPrendas', 'precioConfirmado', 'prendas', 'prendasPorIA', 'cantidadRopaRegular']) ||
            (resource.data.get('precioConfirmado', false) == false &&
              request.resource.data.precioConfirmado == true &&
              request.resource.data.costoPrendas is number &&
              request.resource.data.costoPrendas >= 0)) ) ||
        ( usuarioActual().role == 'repartidor' &&
          resource.data.tipoEntrega == 'recojoDomicilio' &&
          resource.data.repartidorUid == null &&
          request.resource.data.repartidorUid == request.auth.uid &&
          request.resource.data.etapaReparto == 'aceptado' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['repartidorUid', 'etapaReparto', 'repartidorNombre', 'repartidorTelefono']) ) ||
        ( usuarioActual().role == 'repartidor' &&
          resource.data.repartidorUid == request.auth.uid &&
          repartidorAvanzaBien() ) ||
        ( resource.data.clienteId == request.auth.uid &&
          resource.data.estado == 'entregado' &&
          resource.data.calificacionLavanderia == null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['calificacionLavanderia', 'calificacionRepartidor', 'comentarioCalificacion']) ) ||
        esSuperadmin()
      );
      allow delete: if false;

      // La foto de entrega vive aparte para que no viaje dentro de cada
      // listado de pedidos (pesa hasta ~300 KB).
      match /comprobante/{docId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.clienteId == request.auth.uid ||
          get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.repartidorUid == request.auth.uid ||
          usuarioActual().lavanderiaId == get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.lavanderiaId ||
          esSuperadmin()
        );
        allow create: if request.auth != null && docId == 'foto' &&
          usuarioActual().role == 'repartidor' &&
          get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.repartidorUid == request.auth.uid &&
          get(/databases/$(database)/documents/pedidos/$(pedidoId)).data.get('etapaReparto', 'aceptado') == 'devolviendo' &&
          request.resource.data.keys().hasOnly(['fotoBase64']) &&
          request.resource.data.fotoBase64 is string &&
          request.resource.data.fotoBase64.size() > 0 &&
          request.resource.data.fotoBase64.size() < 450000;
        allow update, delete: if false;
      }
    }
  }
}
